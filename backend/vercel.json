{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{apps/**/tests/**,tmp_uploads/**,staticfiles/**,.venv/**,.pytest_cache/**,.ruff_cache/**,.env,.env.*,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
