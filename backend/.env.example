# Em produção (DJANGO_DEBUG=False) a chave PRECISA ser um segredo real: o app se recusa a
# subir com "change-me"/"unsafe-dev-key". (Os testes ficam isentos.)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Registro público de usuários. Ligado, qualquer pessoa com acesso à API cria
# uma conta. Mantenha desligado e crie contas pelo admin/CLI.
DJANGO_ALLOW_PUBLIC_REGISTRATION=True

# Postgres local (docker-compose.yml, porta 5433). A extensão pg_trgm é criada
# pela migration; ela vem no contrib padrão do Postgres.
POSTGRES_DB=myexams
POSTGRES_USER=myexams
POSTGRES_PASSWORD=myexams
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=prefer

REDIS_URL=redis://localhost:6380/0

# Inferência 100% local. Dado de saúde nunca sai da máquina: um OLLAMA_URL que
# não seja local é recusado, a menos que AI_ALLOW_REMOTE_INFERENCE=true.
OLLAMA_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen2.5:14b"
# Modelo de visão: só para páginas sem camada de texto (laudos escaneados).
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
# O default do Ollama (2048/4096) trunca blocos longos em silêncio.
# Cada chamada é pequena (cabeçalho ou até 12 linhas de tabela, < 3k tokens): 4096 basta e
# reserva bem menos memória que 16384. Memória sob pressão faz o modelo cair para ~1-2 tok/s.
OLLAMA_NUM_CTX=4096
# A resposta chega em streaming. STALL = silêncio máximo entre dois pedaços (como os tokens
# chegam sem parar, não dispara numa geração longa); TIMEOUT = teto de relógio de parede POR
# chamada ao modelo. KEEP_ALIVE mantém o modelo carregado entre os blocos do laudo.
OLLAMA_STALL_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_KEEP_ALIVE=30m
# Teto de tokens gerados por chamada (resultados e cabeçalho saem em texto compacto, sem JSON
# Schema). A geração restrita a JSON foi medida a ~4,5 tok/s com qwen2.5:14b num M3 Pro; para
# mais velocidade considere OLLAMA_CHAT_MODEL=qwen2.5:7b. Não use o mesmo Ollama em duas
# extrações (ou clientes) ao mesmo tempo: as requisições concorrentes se atrapalham.
OLLAMA_NUM_PREDICT=1500
# AI_ALLOW_REMOTE_INFERENCE=false
# Liga/desliga o modelo (LLM) na extração. false = SÓ REGRAS: o worker nem tenta falar com o
# Ollama; o que as regras não leem vira "bloco não lido" (dá para digitar o resultado) e PDF
# escaneado (sem texto) falha com o código `llm_disabled`. Sem a variável, o padrão do código é true.
EXTRACTION_USE_LLM=false
# Tempo total (segundos) de chamadas ao modelo por laudo. Passado o teto, as partes que ainda
# iriam ao modelo são puladas e o laudo fica marcado para revisão (aviso `llm_budget_exceeded`).
# As regras rodam antes do modelo e não contam nesse tempo.
EXTRACTION_LLM_BUDGET_SECONDS=240

# Upload. O PDF é guardado só enquanto a extração roda e apagado ao final.
EXAMS_UPLOAD_DIR=tmp_uploads
EXAMS_MAX_UPLOAD_MB=20
EXAMS_MAX_PAGES=60

# Atrás de um proxy reverso confiável, informe quantos proxies há na frente da API
# (o throttle usa o IP real em vez de um X-Forwarded-For forjável). 0 = sem proxy.
DRF_NUM_PROXIES=0

# Faxina de PDFs órfãos / laudos presos em "extraindo" (roda ao iniciar o worker e em
# `manage.py sweep_uploads`). Horas de idade para considerar um arquivo órfão.
EXAMS_ORPHAN_HOURS=3
