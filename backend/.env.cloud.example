# Copie para backend/.env.cloud (ignorado pelo git) e preencha. Lido SÓ pelas tarefas `cloud-*` do
# mise (`cloud-migrate`, `cloud-manage`, `cloud-backup`), nunca pelo servidor local de
# desenvolvimento: é aqui que mora o que aponta para o banco da nuvem. Ver docs/DEPLOY.md.

# Connection string DIRETA do Neon (host SEM "-pooler"): migrações e pg_dump usam SET e sessões,
# que o pooler em modo transação não suporta. A senha precisa vir codificada (%40 para @,
# %2F para /, %23 para #...); a gerada por token_urlsafe não precisa.
DATABASE_MIGRATE_URL=postgresql://myexams_app:<senha>@<endpoint>.<regiao>.aws.neon.tech/<banco>?sslmode=require&channel_binding=require

# Versão principal do Postgres do projeto Neon (a imagem do pg_dump do `cloud-backup`). Padrão: 18 (o projeto MyExams nasceu em 18).
# CLOUD_PG_MAJOR=17

# Tem de ser igual ao do projeto Vercel do backend. Vazio = esquema `public` (o recomendado no Neon).
# DATABASE_SCHEMA=myexams
DJANGO_CACHE=db
CELERY_TASK_ALWAYS_EAGER=true
EXTRACTION_USE_LLM=false
DJANGO_CHANNEL_LAYER=none
