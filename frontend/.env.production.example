# Variáveis do projeto Vercel do FRONTEND (Root Directory: frontend). Não são segredos: o Nuxt
# as grava no JavaScript do navegador durante o build (SPA). Mudou uma? Faça um novo deploy.
# Valores de exemplo: troque pelos seus domínios.

# URL pública da API (projeto Vercel do backend), com /api/v1 e sem barra final.
NUXT_PUBLIC_API_BASE_URL=https://api.exemplo.com.br/api/v1
NUXT_PUBLIC_GRAPHQL_ENDPOINT=https://api.exemplo.com.br/graphql/

# A nuvem não tem WebSocket: sem tempo real, as telas atualizam por polling (5 s).
NUXT_PUBLIC_REALTIME=false
# NUXT_PUBLIC_WS_BASE_URL=wss://ws.exemplo.com.br   # só se um dia houver um servidor de WebSocket

# Plano B do limite de upload (MB). O normal é a API informar o dela em /auth/me/.
# NUXT_PUBLIC_MAX_UPLOAD_MB=4
